# Copy this file to .env and fill in ONE key. .env is git-ignored.
# replay (the default) needs no key: recorded replies, used by the checks and CI.
LLM_PROVIDER=replay
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Only for LLM_PROVIDER=ollama: the local model to use for every role.
OLLAMA_MODEL=
